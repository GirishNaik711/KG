# Force LF line endings for all text files (prevents CRLF/LF churn on Windows/WSL)
* text=auto eol=lf

# Ensure shell scripts always use LF
*.sh text eol=lf
scripts/rapids-run text eol=lf

# Binary files
*.png binary
*.jpg binary
*.ico binary
*.pdf binary

# Codemap database — regenerable binary, auto-resolve conflicts by keeping current branch
.rapids/codebase-intel/codemap.db merge=ours binary
