# ─────────────────────────────────────────────────────────────────────────────
# spend-visibility-mvp — environment variable catalog
#
# THIS FILE IS COMMITTED. It lists every variable the application needs, with
# SAFE PLACEHOLDERS ONLY — never a real secret, key, password, or endpoint.
#
#   cp .env.example .env    # then edit .env with real values
#
# .env is gitignored and is the ONLY place real values live.
#
# CONTRACT (enforced at app startup by the env checker):
#   * Every variable the code reads MUST be listed here.
#   * Every module that introduces a variable adds it here in the same change,
#     and registers it in the checker's required list.
#   * A variable that is missing or empty at startup fails the app with
#     ERR_CDR_78_EX_CONFIG naming exactly what is absent.
#
# Format: one `NAME=placeholder` per line, grouped by concern, with a comment
# above each group explaining what reads it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
# Required by the local backend and frontend.
APP_ENV=local
BACKEND_CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Frontend authentication and API endpoints. Set AUTH_ENABLED=false locally
# until PING OIDC values are provisioned for the selected environment.
AUTH_ENABLED=false
AUTH_SECRET=replace-with-a-long-random-value
AUTH_CLIENT_ID=replace-with-ping-client-id
AUTH_CLIENT_SECRET=replace-with-ping-client-secret
AUTH_ISSUER_DEV=https://ping-dev.example.com
AUTH_ISSUER_STAGE=https://ping-stage.example.com
AUTH_ISSUER_PROD=https://ping.example.com
NEXT_PUBLIC_APP_ENV=dev
NEXT_PUBLIC_API_URL_DEV=http://localhost:8000
NEXT_PUBLIC_API_URL_STAGE=https://backend-stage.example.com
NEXT_PUBLIC_API_URL_PROD=https://backend.example.com

# ── Datastores ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://spend:spend@localhost:5432/spend
REDIS_URL=redis://localhost:6379/0

# ── Third-party services ─────────────────────────────────────────────────────
OPENAI_API_KEY=sk-replace-me
AZURE_CONTENT_SAFETY_ENDPOINT=https://replace-me.cognitiveservices.azure.com/
AZURE_CONTENT_SAFETY_KEY=replace-me
DATAMART_MCP_URL=https://replace-me/mcp
DATAMART_MCP_AUDIENCE=replace-me

# ── Observability (optional locally; required in hosted environments) ───────
DYNATRACE_OTLP_ENDPOINT=https://{environment-id}.live.dynatrace.com/api/v2/otlp
DYNATRACE_API_TOKEN=dt0c01.replace-me
OTEL_SERVICE_NAME=spend-visibility-backend
LANGSMITH_API_KEY=lsv2_pt_replace-me
LANGSMITH_PROJECT=spend-visibility-mvp
LANGCHAIN_TRACING_V2=true
